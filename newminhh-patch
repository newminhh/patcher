#!/usr/bin/env bash
set -euo pipefail

# newminhh-patch — Hybrid Static Binary Patcher CLI (backed by Docker re-env:latest)
# Usage: newminhh-patch [--hybrid-fallback] [--no-hybrid-fallback] [--use-ghidra] [--use-r2] <input-i386-elf> -o <output-x32-elf>

PATCHER_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
RE_IMAGE="${NEWMINHH_RE_IMAGE:-re-env:latest}"

usage() {
    cat >&2 <<'EOF'
Usage: newminhh-patch [--hybrid-fallback] [--no-hybrid-fallback] [--use-ghidra] [--use-r2] <input-i386-elf> -o <output-x32-elf>
EOF
}

INPUT_PATH=""
OUTPUT_PATH=""
EXTRA_FLAGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --hybrid-fallback|--no-hybrid-fallback|--use-ghidra|--use-r2|-v|--verbose)
            EXTRA_FLAGS+=("$1")
            shift
            ;;
        -o|--output)
            if [[ $# -lt 2 ]]; then
                echo "[newminhh:patcher] ERROR: missing argument after $1" >&2
                usage
                exit 2
            fi
            OUTPUT_PATH="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            echo "[newminhh:patcher] ERROR: unknown option '$1'" >&2
            usage
            exit 2
            ;;
        *)
            if [[ -n "${INPUT_PATH}" ]]; then
                echo "[newminhh:patcher] ERROR: multiple input files specified ('${INPUT_PATH}' and '$1')" >&2
                usage
                exit 2
            fi
            INPUT_PATH="$1"
            shift
            ;;
    esac
done

if [[ -z "${INPUT_PATH}" || -z "${OUTPUT_PATH}" ]]; then
    echo "[newminhh:patcher] ERROR: both <input-i386-elf> and -o <output-x32-elf> are required" >&2
    usage
    exit 2
fi

if [[ ! -e "${INPUT_PATH}" ]]; then
    echo "[newminhh:patcher] ERROR: input file does not exist: ${INPUT_PATH}" >&2
    exit 1
fi

if ! command -v docker >/dev/null 2>&1; then
    echo "[newminhh:patcher] ERROR: docker not found in PATH" >&2
    exit 1
fi

ABS_IN="$(readlink -f -- "${INPUT_PATH}")"
IN_DIR="$(dirname -- "${ABS_IN}")"
IN_BASE="$(basename -- "${ABS_IN}")"

OUT_PARENT="$(dirname -- "${OUTPUT_PATH}")"
mkdir -p -- "${OUT_PARENT}"
ABS_OUT_DIR="$(cd -- "${OUT_PARENT}" && pwd)"
OUT_BASE="$(basename -- "${OUTPUT_PATH}")"
ABS_OUT="${ABS_OUT_DIR}/${OUT_BASE}"

if [[ "${ABS_IN}" == "${ABS_OUT}" ]]; then
    echo "[newminhh:patcher] ERROR: input and output paths must be distinct" >&2
    exit 2
fi

# Remove any stale output before patching so failed runs never leave stale artifacts
rm -f -- "${ABS_OUT}"

DOCKER_MOUNTS=(
    -v "${PATCHER_DIR}:/opt/newminhh_patcher:ro"
    -v "${ABS_OUT_DIR}:/work_out:rw"
)

if [[ "${IN_DIR}" == "${ABS_OUT_DIR}" ]]; then
    CONTAINER_IN="/work_out/${IN_BASE}"
else
    DOCKER_MOUNTS+=(-v "${IN_DIR}:/work_in:ro")
    CONTAINER_IN="/work_in/${IN_BASE}"
fi
CONTAINER_OUT="/work_out/${OUT_BASE}"

set +e
docker run --rm \
    --user "$(id -u):$(id -g)" \
    -e HOME=/tmp \
    -e PWNLIB_NOTERM=1 \
    -e JAVA_TOOL_OPTIONS=-Dfile.encoding=UTF-8 \
    -e PYTHONPATH=/opt/newminhh_patcher \
    "${DOCKER_MOUNTS[@]}" \
    "${RE_IMAGE}" \
    /opt/re-venv/bin/python3 -m re_patcher.cli \
        "${EXTRA_FLAGS[@]}" \
        "${CONTAINER_IN}" -o "${CONTAINER_OUT}"
RC=$?
set -e

if [[ ${RC} -ne 0 ]]; then
    rm -f -- "${ABS_OUT}"
    exit "${RC}"
fi

if [[ ! -f "${ABS_OUT}" ]]; then
    echo "[newminhh:patcher] ERROR: patcher reported success but output was not created: ${ABS_OUT}" >&2
    exit 1
fi

chmod +x -- "${ABS_OUT}"
exit 0
